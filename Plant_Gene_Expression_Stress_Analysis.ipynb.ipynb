   "source": [
    "import pandas as pd\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/plotly/datasets/master/gapminder2007.csv\"\n",
    "df = pd.read_csv(url)\n",
    "\n",
    "df.head()\n",
    "\n",
    "df.info()\n",
    "df.describe()\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df['lifeExp'].hist()\n",
    "plt.title(\"Gene Expression Proxy Distribution\")\n",
    "plt.show()"
   ]
